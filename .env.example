# Minecraft connection
MC_HOST=localhost
MC_PORT=25565
MC_ACCOUNT=you@example.com
MC_AUTH=microsoft
MC_VERSION=26.2

# Who the bot takes orders from (in-game username)
MC_OWNER=YourMinecraftName
# Display name used by the Discord bridge, if any (messages look like "Discord <name>: <msg>")
DISCORD_OWNER=

# LLM (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b
# false | true | low | medium | high
OLLAMA_THINK=low
OLLAMA_NUM_CTX=16384

# Agent behaviour
AGENT_MAX_STEPS=40
AUTO_EAT=true
LOG_LEVEL=info

# Diagnostics: off | kick (write logs/kick-*.log with recent packets on kick/error) | all (also log packets live)
LOG_PACKETS=kick
PACKET_BUFFER=200
# debug shows server system messages and tool internals
# LOG_LEVEL=debug
